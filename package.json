{
  "name": "dsh-ascend-perf",
  "version": "1.1.4",
  "private": false,
  "type": "module",
  "description": "DeepSeek Harness 的昇腾 NPU 环境监控、受控 vLLM 容器服务与性能调优插件（源码主仓）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "profile.js",
    "deploy.js",
    "deploy-exec.js",
    "tune.js",
    "tune-exec.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "fixtures/profile/demo-profile.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0 || >=0.2.2-alpha.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/newpage1/dsh-ascend-perf.git"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "build:market": "node scripts/build-market.mjs"
  }
}
